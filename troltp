-- Orbit Target UI
-- Client-side orbit untuk game sendiri/private testing

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local GUI_NAME = "NixxOrbitTargetGui"

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then
    oldGui:Destroy()
end

local Orbiting = false
local OrbitConnection = nil
local SelectedTarget = nil
local SavedHumanoid = nil
local SavedAutoRotate = true
local OrbitAngle = 0

local function Notify(message)
    if StatusLabel and StatusLabel.Parent then
        StatusLabel.Text = message
    end

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "NIXX Orbit",
            Text = message,
            Duration = 2
        })
    end)
end

local function Trim(text)
    return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function FindPlayer(query)
    query = Trim(query):lower()

    if query == "" then
        return nil
    end

    -- Prioritaskan username atau display name yang sama persis
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower() == query
                or player.DisplayName:lower() == query then
                return player
            end
        end
    end

    -- Jika tidak sama persis, gunakan pencarian sebagian
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower():sub(1, #query) == query
                or player.DisplayName:lower():sub(1, #query) == query then
                return player
            end
        end
    end

    return nil
end

local function GetNumber(text, defaultValue, minimum, maximum)
    local value = tonumber(text)

    if not value then
        value = defaultValue
    end

    return math.clamp(value, minimum, maximum)
end

local function SetButtonState(active)
    if not OrbitButton or not OrbitButton.Parent then
        return
    end

    OrbitButton.Text = active and "Orbit: ON" or "Orbit: OFF"

    OrbitButton.BackgroundColor3 = active
        and Color3.fromRGB(0, 150, 90)
        or Color3.fromRGB(35, 35, 45)
end

local function StopOrbit(message)
    Orbiting = false

    if OrbitConnection then
        OrbitConnection:Disconnect()
        OrbitConnection = nil
    end

    if SavedHumanoid and SavedHumanoid.Parent then
        SavedHumanoid.AutoRotate = SavedAutoRotate
    end

    SavedHumanoid = nil
    SetButtonState(false)

    if message then
        Notify(message)
    end
end

local function StartOrbit()
    if Orbiting then
        return
    end

    local target = FindPlayer(TargetBox.Text)

    if not target then
        Notify("Target tidak ditemukan")
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    local targetCharacter = target.Character
    local targetRoot = targetCharacter
        and targetCharacter:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        Notify("Karakter kamu belum siap")
        return
    end

    if not targetRoot then
        Notify("Karakter target belum siap")
        return
    end

    SelectedTarget = target
    Orbiting = true
    OrbitAngle = 0

    SavedHumanoid = humanoid
    SavedAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false

    SetButtonState(true)
    Notify("Orbit mengelilingi " .. target.DisplayName)

    OrbitConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not Orbiting then
            return
        end

        local currentCharacter = LocalPlayer.Character
        local currentRoot = currentCharacter
            and currentCharacter:FindFirstChild("HumanoidRootPart")

        local currentTargetCharacter = SelectedTarget
            and SelectedTarget.Character

        local currentTargetRoot = currentTargetCharacter
            and currentTargetCharacter:FindFirstChild("HumanoidRootPart")

        if not currentRoot then
            StopOrbit("Karakter kamu tidak tersedia")
            return
        end

        if not SelectedTarget
            or not SelectedTarget.Parent
            or not currentTargetRoot then
            StopOrbit("Target keluar atau respawn")
            return
        end

        local distance = GetNumber(
            DistanceBox.Text,
            8,
            3,
            50
        )

        local speed = GetNumber(
            SpeedBox.Text,
            1.8,
            0.2,
            10
        )

        local height = GetNumber(
            HeightBox.Text,
            0,
            -5,
            25
        )

        OrbitAngle += deltaTime * speed

        local offset = Vector3.new(
            math.cos(OrbitAngle) * distance,
            height,
            math.sin(OrbitAngle) * distance
        )

        local targetPosition = currentTargetRoot.Position
        local orbitPosition = targetPosition + offset
        local lookPosition = targetPosition + Vector3.new(0, 2, 0)

        currentRoot.CFrame = CFrame.lookAt(
            orbitPosition,
            lookPosition
        )

        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero

        if StatusLabel and StatusLabel.Parent then
            StatusLabel.Text = string.format(
                "Orbit: %s | Jarak: %d",
                SelectedTarget.DisplayName,
                math.floor(distance)
            )
        end
    end)
end

