-- Tombol
-- =========================================================

SetTargetButton.Activated:Connect(function()
    local target = FindPlayer(TargetBox.Text)

    if target then
        SelectedTarget = target
        TargetBox.Text = target.Name
        Notify("Target dipilih: " .. target.DisplayName)
    else
        Notify("Player tidak ditemukan")
    end
end)

OrbitButton.Activated:Connect(function()
    if Orbiting then
        StopOrbit("Orbit dihentikan")
    else
        StartOrbit()
    end
end)

StopButton.Activated:Connect(function()
    StopOrbit("Orbit dihentikan")
end)

CloseButton.Activated:Connect(function()
    StopOrbit(nil)
    OrbitGui:Destroy()
end)

LocalPlayer.CharacterAdded:Connect(function()
    StopOrbit("Respawn | Orbit dihentikan")
end)

Players.PlayerRemoving:Connect(function(player)
    if player == SelectedTarget then
        StopOrbit("Target keluar server")
        SelectedTarget = nil
    end
end)
