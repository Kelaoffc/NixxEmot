-- Lampu Kepala standalone
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local GUI_NAME = "NixxStandaloneHeadLampGui"
local LAMP_NAME = "NixxHeadLamp"

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then
    oldGui:Destroy()
end

local LampOn = false
local HeadLamp = nil
local LampBtn = nil

local function SetButtonState(active)
    if not LampBtn or not LampBtn.Parent then return end

    LampBtn.Text = active and "Lampu: ON" or "Lampu: OFF"
    LampBtn.BackgroundColor3 = active
        and Color3.fromRGB(190, 160, 35)
        or Color3.fromRGB(35, 35, 45)
end

local function RemoveHeadLamp()
    if HeadLamp and HeadLamp.Parent then
        HeadLamp:Destroy()
    end

    HeadLamp = nil
end

local function AddHeadLamp(character)
    if not character then return false end

    local head = character:FindFirstChild("Head")
    if not head then return false end

    local existingLamp = character:FindFirstChild(LAMP_NAME)
    if existingLamp then
        HeadLamp = existingLamp
        return true
    end

    HeadLamp = Instance.new("Part")
    HeadLamp.Name = LAMP_NAME
    HeadLamp.Shape = Enum.PartType.Ball
    HeadLamp.Size = Vector3.new(0.5, 0.5, 0.5)
    HeadLamp.Color = Color3.fromRGB(255, 255, 255)
    HeadLamp.Material = Enum.Material.Neon
    HeadLamp.Transparency = 1
    HeadLamp.Anchored = false
    HeadLamp.CanCollide = false
    HeadLamp.CanTouch = false
    HeadLamp.CanQuery = false
    HeadLamp.Massless = true
    HeadLamp.CFrame = head.CFrame * CFrame.new(0, 0.8, 0)
    HeadLamp.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head
    weld.Part1 = HeadLamp
    weld.Parent = HeadLamp

    local light = Instance.new("PointLight")
    light.Name = "HeadLampLight"
    light.Color = Color3.fromRGB(255, 255, 255)
    light.Range = 60
    light.Brightness = 2
    light.Shadows = true
    light.Parent = HeadLamp

    return true
end

local function TurnLampOn()
    local character = Player.Character or Player.CharacterAdded:Wait()
    if AddHeadLamp(character) then
        LampOn = true
        SetButtonState(true)
        return true
    end

    LampOn = false
    SetButtonState(false)
    return false
end

local function TurnLampOff()
    LampOn = false
    RemoveHeadLamp()
    SetButtonState(false)
end

local LampGui = Instance.new("ScreenGui")
LampGui.Name = GUI_NAME
LampGui.ResetOnSpawn = false
LampGui.Parent = PlayerGui

local LampFrame = Instance.new("Frame")
LampFrame.Size = UDim2.fromOffset(158, 38)
LampFrame.Position = UDim2.new(0, 20, 0.5, 75)
LampFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 25)
LampFrame.BorderSizePixel = 0
LampFrame.Active = true
LampFrame.Parent = LampGui

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 7)
FrameCorner.Parent = LampFrame

LampBtn = Instance.new("TextButton")
LampBtn.Size = UDim2.fromOffset(100, 28)
LampBtn.Position = UDim2.fromOffset(20, 5)
LampBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
LampBtn.BorderSizePixel = 0
LampBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
LampBtn.TextSize = 11
LampBtn.Font = Enum.Font.GothamBold
LampBtn.Text = "Lampu: OFF"
LampBtn.Parent = LampFrame

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 5)
ButtonCorner.Parent = LampBtn

local DragHandle = Instance.new("TextButton")
DragHandle.Size = UDim2.fromOffset(14, 28)
DragHandle.Position = UDim2.fromOffset(3, 5)
DragHandle.BackgroundTransparency = 1
DragHandle.BorderSizePixel = 0
DragHandle.Text = "≡"
DragHandle.TextColor3 = Color3.fromRGB(150, 150, 165)
DragHandle.TextSize = 16
DragHandle.Font = Enum.Font.GothamBold
DragHandle.Parent = LampFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(28, 28)
CloseBtn.Position = UDim2.fromOffset(125, 5)
CloseBtn.BackgroundColor3 = Color3.fromRGB(150, 45, 55)
CloseBtn.BorderSizePixel = 0
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize = 12
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Parent = LampFrame

local CloseCorner = Instance.new("UICorner")
CloseCorner.CornerRadius = UDim.new(0, 5)
CloseCorner.Parent = CloseBtn

local dragging = false
local dragInput = nil
local dragStart = nil
local startPosition = nil

DragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = LampFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

DragHandle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        LampFrame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

LampBtn.MouseButton1Click:Connect(function()
    if LampOn then
        TurnLampOff()
    else
        TurnLampOn()
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    TurnLampOff()
    LampGui:Destroy()
end)

Player.CharacterAdded:Connect(function(character)
    RemoveHeadLamp()

    if LampOn then
        task.wait(1)
        if AddHeadLamp(character) then
            SetButtonState(true)
        else
            LampOn = false
            SetButtonState(false)
        end
    end
end)
