-- Airwalk standalone
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local GUI_NAME = "NixxStandaloneAirwalkGui"
local PART_NAME = "NixxStandaloneAirwalkPart"

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then oldGui:Destroy() end

local oldPart = Workspace:FindFirstChild(PART_NAME)
if oldPart then oldPart:Destroy() end

local AirwalkActive = false
local AirWPart = nil
local AirwalkConnection = nil
local AirwalkBtn = nil

local function SetButtonState(active)
    if not AirwalkBtn or not AirwalkBtn.Parent then return end
    AirwalkBtn.Text = active and "Airwalk: ON" or "Airwalk: OFF"
    AirwalkBtn.BackgroundColor3 = active
        and Color3.fromRGB(0, 170, 90)
        or Color3.fromRGB(35, 35, 45)
end

local function StopAirwalk()
    AirwalkActive = false

    if AirwalkConnection then
        AirwalkConnection:Disconnect()
        AirwalkConnection = nil
    end

    if AirWPart then
        AirWPart:Destroy()
        AirWPart = nil
    end

    if AirwalkBtn then
        SetButtonState(false)
    end
end

local function StartAirwalk()
    if AirWPart then return true end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    AirWPart = Instance.new("Part")
    AirWPart.Name = PART_NAME
    AirWPart.Size = Vector3.new(7, 1, 3)
    AirWPart.CFrame = CFrame.new(
        root.Position.X,
        root.Position.Y - (root.Size.Y / 2 + 0.5),
        root.Position.Z
    )
    AirWPart.Anchored = true
    AirWPart.CanCollide = true
    AirWPart.CanTouch = false
    AirWPart.CanQuery = false
    AirWPart.Transparency = 1
    AirWPart.Parent = Workspace

    AirwalkActive = true
    AirwalkConnection = RunService.Heartbeat:Connect(function()
        if not AirwalkActive or not AirWPart or not AirWPart.Parent then
            StopAirwalk()
            return
        end

        local currentCharacter = LocalPlayer.Character
        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if not currentRoot then
            StopAirwalk()
            return
        end

        AirWPart.Position = Vector3.new(
            currentRoot.Position.X,
            AirWPart.Position.Y,
            currentRoot.Position.Z
        )
    end)

    return true
end

local AirwalkGui = Instance.new("ScreenGui")
AirwalkGui.Name = GUI_NAME
AirwalkGui.ResetOnSpawn = false
AirwalkGui.Parent = PlayerGui

local AirwalkFrame = Instance.new("Frame")
AirwalkFrame.Size = UDim2.fromOffset(158, 38)
AirwalkFrame.Position = UDim2.new(0, 20, 0.5, -19)
AirwalkFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 25)
AirwalkFrame.BorderSizePixel = 0
AirwalkFrame.Active = true
AirwalkFrame.Parent = AirwalkGui

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 7)
FrameCorner.Parent = AirwalkFrame

AirwalkBtn = Instance.new("TextButton")
AirwalkBtn.Size = UDim2.fromOffset(100, 28)
AirwalkBtn.Position = UDim2.fromOffset(20, 5)
AirwalkBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
AirwalkBtn.BorderSizePixel = 0
AirwalkBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AirwalkBtn.TextSize = 11
AirwalkBtn.Font = Enum.Font.GothamBold
AirwalkBtn.Text = "Airwalk: OFF"
AirwalkBtn.Parent = AirwalkFrame

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 5)
Corner.Parent = AirwalkBtn

local DragHandle = Instance.new("TextButton")
DragHandle.Size = UDim2.fromOffset(14, 28)
DragHandle.Position = UDim2.fromOffset(3, 5)
DragHandle.BackgroundTransparency = 1
DragHandle.BorderSizePixel = 0
DragHandle.Text = "≡"
DragHandle.TextColor3 = Color3.fromRGB(150, 150, 165)
DragHandle.TextSize = 16
DragHandle.Font = Enum.Font.GothamBold
DragHandle.Parent = AirwalkFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(28, 28)
CloseBtn.Position = UDim2.fromOffset(125, 5)
CloseBtn.BackgroundColor3 = Color3.fromRGB(150, 45, 55)
CloseBtn.BorderSizePixel = 0
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize = 12
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Parent = AirwalkFrame

local CloseCorner = Instance.new("UICorner")
CloseCorner.CornerRadius = UDim.new(0, 5)
CloseCorner.Parent = CloseBtn

local dragging = false
local dragInput = nil
local dragStart = nil
local startPosition = nil

DragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = AirwalkFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

DragHandle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        AirwalkFrame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

AirwalkBtn.MouseButton1Click:Connect(function()
    if AirwalkActive then
        StopAirwalk()
    elseif StartAirwalk() then
        SetButtonState(true)
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    StopAirwalk()
    AirwalkGui:Destroy()
end)

LocalPlayer.CharacterAdded:Connect(function()
    StopAirwalk()
end)
