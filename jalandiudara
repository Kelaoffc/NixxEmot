-- Airwalk standalone
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local GUI_NAME = "NixxStandaloneAirwalkGui"
local PART_NAME = "NixxStandaloneAirwalkPart"

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then oldGui:Destroy() end

local oldPart = Workspace:FindFirstChild(PART_NAME)
if oldPart then oldPart:Destroy() end

local AirwalkActive = false
local AirWPart = nil
local AirwalkConnection = nil
local AirwalkBtn = nil

local function SetButtonState(active)
    AirwalkBtn.Text = active and "🚶 Jalan di udara: ON" or "🚶 Jalan di udara: OFF"
    AirwalkBtn.BackgroundColor3 = active
        and Color3.fromRGB(0, 170, 90)
        or Color3.fromRGB(35, 35, 45)
end

local function StopAirwalk()
    AirwalkActive = false

    if AirwalkConnection then
        AirwalkConnection:Disconnect()
        AirwalkConnection = nil
    end

    if AirWPart then
        AirWPart:Destroy()
        AirWPart = nil
    end

    if AirwalkBtn then
        SetButtonState(false)
    end
end

local function StartAirwalk()
    if AirWPart then return true end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    AirWPart = Instance.new("Part")
    AirWPart.Name = PART_NAME
    AirWPart.Size = Vector3.new(7, 1, 3)
    AirWPart.CFrame = CFrame.new(
        root.Position.X,
        root.Position.Y - (root.Size.Y / 2 + 0.5),
        root.Position.Z
    )
    AirWPart.Anchored = true
    AirWPart.CanCollide = true
    AirWPart.CanTouch = false
    AirWPart.CanQuery = false
    AirWPart.Transparency = 1
    AirWPart.Parent = Workspace

    AirwalkActive = true
    AirwalkConnection = RunService.Heartbeat:Connect(function()
        if not AirwalkActive or not AirWPart or not AirWPart.Parent then
            StopAirwalk()
            return
        end

        local currentCharacter = LocalPlayer.Character
        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if not currentRoot then
            StopAirwalk()
            return
        end

        AirWPart.Position = Vector3.new(
            currentRoot.Position.X,
            AirWPart.Position.Y,
            currentRoot.Position.Z
        )
    end)

    return true
end

local AirwalkGui = Instance.new("ScreenGui")
AirwalkGui.Name = GUI_NAME
AirwalkGui.ResetOnSpawn = false
AirwalkGui.Parent = PlayerGui

AirwalkBtn = Instance.new("TextButton")
AirwalkBtn.Size = UDim2.fromOffset(190, 40)
AirwalkBtn.Position = UDim2.new(0, 20, 0.5, -20)
AirwalkBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
AirwalkBtn.BorderSizePixel = 0
AirwalkBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AirwalkBtn.TextSize = 14
AirwalkBtn.Font = Enum.Font.GothamBold
AirwalkBtn.Text = "🚶 Jalan di udara: OFF"
AirwalkBtn.Parent = AirwalkGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 8)
Corner.Parent = AirwalkBtn

AirwalkBtn.MouseButton1Click:Connect(function()
    if AirwalkActive then
        StopAirwalk()
    elseif StartAirwalk() then
        SetButtonState(true)
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    StopAirwalk()
end)
