-- BringPart standalone
-- Membawa BasePart tidak anchored ke sekitar karakter tanpa scan setiap frame.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local GUI_NAME = "NixxStandaloneBringPartGui"
local SCAN_INTERVAL = 0.25
local MAX_PARTS_PER_SCAN = 80
local BRING_RADIUS = 7

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then
    oldGui:Destroy()
end

local Bringing = false
local BringConnection = nil
local BringButton = nil
local StatusLabel = nil
local LastMovedCount = 0

local function Notify(message)
    if StatusLabel and StatusLabel.Parent then
        StatusLabel.Text = message
    end

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "NIXX BringPart",
            Text = message,
            Duration = 2
        })
    end)
end

local function SetButtonState(active)
    if not BringButton or not BringButton.Parent then return end

    BringButton.Text = active and "Bring: ON" or "Bring: OFF"
    BringButton.BackgroundColor3 = active
        and Color3.fromRGB(170, 105, 25)
        or Color3.fromRGB(35, 35, 45)
end

local function IsCharacterPart(part)
    local model = part and part:FindFirstAncestorOfClass("Model")
    if not model then return false end

    -- Jangan pernah menarik bagian avatar pemain atau NPC.
    -- Ini mencegah HumanoidRootPart/limbs ikut terseret dan membuat avatar lag.
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function GetBringDestination(root, index)
    -- Sebarkan benda mengelilingi pemain, jangan menumpuk di satu CFrame.
    local angle = index * 1.8
    local layer = math.floor((index - 1) / 8)
    local radius = BRING_RADIUS + ((index - 1) % 4) * 1.5
    local height = 3 + layer * 1.75

    return root.CFrame * CFrame.new(
        math.cos(angle) * radius,
        height,
        math.sin(angle) * radius
    )
end

local function IsBringablePart(part, character)
    if not part or not part:IsA("BasePart") then return false end
    if part.Anchored then return false end
    if not part.Parent then return false end
    if character and part:IsDescendantOf(character) then return false end
    if IsCharacterPart(part) then return false end
    if part:IsDescendantOf(Player) then return false end
    local camera = Workspace.CurrentCamera
    if camera and part:IsDescendantOf(camera) then return false end
    return true
end

local function BringPartBatch()
    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end

    local moved = 0
    for _, part in ipairs(Workspace:GetDescendants()) do
        if moved >= MAX_PARTS_PER_SCAN then break end

        if IsBringablePart(part, character) then
            local success = pcall(function()
                part.CFrame = GetBringDestination(root, moved + 1)
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)

            if success then
                moved += 1
            end
        end
    end

    return moved
end

local function StopBringing(showNotification)
    Bringing = false

    if BringConnection then
        BringConnection:Disconnect()
        BringConnection = nil
    end

    SetButtonState(false)
    if showNotification then
        Notify("Bring berhenti | " .. tostring(LastMovedCount) .. " part terakhir")
    end
end

local function StartBringing()
    if Bringing then return end

    Bringing = true
    LastMovedCount = 0
    SetButtonState(true)
    Notify("Bring aktif | max " .. tostring(MAX_PARTS_PER_SCAN) .. " part/scan")

    local elapsed = SCAN_INTERVAL
    BringConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not Bringing then return end

        elapsed += deltaTime
        if elapsed < SCAN_INTERVAL then return end
        elapsed = 0

        LastMovedCount = BringPartBatch()
        if StatusLabel and StatusLabel.Parent then
            StatusLabel.Text = "Membawa " .. tostring(LastMovedCount) .. " part"
        end
    end)
end

