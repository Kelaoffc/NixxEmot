-- NIXX Record - standalone recorder
-- Merekam posisi dan rotasi HumanoidRootPart, lalu bisa diputar ulang.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local GUI_NAME = "NixxFullRecordGui"
local SAVE_FILE = "NixxRecord.json"
local SAMPLE_RATE = 1 / 20

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then
    oldGui:Destroy()
end

local Recording = false
local Playing = false
local RecordFrames = {}
local RecordConnection = nil
local PlaybackThread = nil
local SavedAutoRotate = true
local RecordStatus = nil
local RecordButton = nil
local PlayButton = nil
local StopButton = nil

local function SetStatus(message)
    if RecordStatus and RecordStatus.Parent then
        RecordStatus.Text = message
    end
end

local function Notify(message)
    SetStatus(message)

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "NIXX Record",
            Text = message,
            Duration = 2
        })
    end)
end

local function GetRootAndHumanoid()
    local character = Player.Character
    if not character then return nil, nil end

    return character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChildOfClass("Humanoid")
end

local function FrameToData(cframe, timestamp)
    return {
        t = timestamp,
        c = {cframe:GetComponents()}
    }
end

local function DataToCFrame(frame)
    if not frame or type(frame.c) ~= "table" or #frame.c < 12 then
        return nil
    end

    return CFrame.new(table.unpack(frame.c))
end

local function UpdateButtonStates()
    if not RecordButton or not RecordButton.Parent then return end

    RecordButton.Text = Recording and "Recording..." or "Record"
    RecordButton.BackgroundColor3 = Recording
        and Color3.fromRGB(180, 45, 55)
        or Color3.fromRGB(35, 35, 45)

    PlayButton.Text = Playing and "Playing..." or "Play"
    PlayButton.BackgroundColor3 = Playing
        and Color3.fromRGB(0, 145, 185)
        or Color3.fromRGB(35, 35, 45)

    StopButton.BackgroundColor3 = (Recording or Playing)
        and Color3.fromRGB(150, 80, 35)
        or Color3.fromRGB(35, 35, 45)
end

local function StopPlayback(showNotification)
    Playing = false
    PlaybackThread = nil

    local _, humanoid = GetRootAndHumanoid()
    if humanoid and humanoid.Parent then
        humanoid.AutoRotate = SavedAutoRotate
    end

    UpdateButtonStates()
    if showNotification then
        Notify("Playback dihentikan")
    end
end

local function StopRecording(showNotification)
    Recording = false

    if RecordConnection then
        RecordConnection:Disconnect()
        RecordConnection = nil
    end

    UpdateButtonStates()
    if showNotification then
        Notify("Record selesai: " .. tostring(#RecordFrames) .. " frame")
    end
end

local function StartRecording()
    if Playing then
        StopPlayback(false)
    end

    if Recording then return end

    local root = GetRootAndHumanoid()
    if not root then
        Notify("Karakter belum siap")
        return
    end

    RecordFrames = {}
    Recording = true
    local startedAt = os.clock()
    local nextSample = 0

    RecordConnection = RunService.Heartbeat:Connect(function()
        if not Recording then return end

        local currentRoot = GetRootAndHumanoid()
        if not currentRoot then
            StopRecording(true)
            return
        end

        local elapsed = os.clock() - startedAt
        if elapsed >= nextSample then
            table.insert(
                RecordFrames,
                FrameToData(currentRoot.CFrame, elapsed)
            )
            nextSample += SAMPLE_RATE
        end

        SetStatus("Merekam... " .. tostring(#RecordFrames) .. " frame")
    end)

    UpdateButtonStates()
    Notify("Record dimulai")
end

local function StartPlayback()
    if Playing then return end

    if Recording then
        StopRecording(false)
    end

    if #RecordFrames == 0 then
        Notify("Belum ada hasil record")
        return
    end

    local root, humanoid = GetRootAndHumanoid()
    if not root or not humanoid then
        Notify("Karakter belum siap")
        return
    end

    Playing = true
    SavedAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    UpdateButtonStates()
    Notify("Playback dimulai")

    PlaybackThread = task.spawn(function()
        local startedAt = os.clock()
        local frameIndex = 1

        while Playing and frameIndex <= #RecordFrames do
            local frame = RecordFrames[frameIndex]
            local targetTime = tonumber(frame.t) or 0
            local elapsed = os.clock() - startedAt

            if elapsed >= targetTime then
                local currentRoot = GetRootAndHumanoid()
                local cframe = DataToCFrame(frame)
                if currentRoot and cframe then
                    currentRoot.CFrame = cframe
                    currentRoot.AssemblyLinearVelocity = Vector3.zero
                end
                frameIndex += 1
            else
                RunService.Heartbeat:Wait()
            end
        end

        if Playing then
            Playing = false
            local _, currentHumanoid = GetRootAndHumanoid()
            if currentHumanoid and currentHumanoid.Parent then
                currentHumanoid.AutoRotate = SavedAutoRotate
            end
            UpdateButtonStates()
            Notify("Playback selesai")
        end
    end)
end

local function SaveRecord()
    if #RecordFrames == 0 then
        Notify("Tidak ada record untuk disimpan")
        return
    end

    if not writefile then
        Notify("Executor tidak mendukung writefile")
        return
    end

    local payload = {
        version = 1,
        createdAt = os.time(),
        frameCount = #RecordFrames,
        frames = RecordFrames
    }

    local success, err = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(payload))
    end)

    if success then
        Notify("Tersimpan: " .. SAVE_FILE)
    else
        warn("[NIXX Record] Save error: " .. tostring(err))
        Notify("Gagal menyimpan record")
    end
end

local function LoadRecord()
    if not readfile or not isfile or not isfile(SAVE_FILE) then
        Notify("File record belum ada")
        return
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(SAVE_FILE))
    end)

    if not success or type(data) ~= "table" or type(data.frames) ~= "table" then
        Notify("File record rusak")
        return
    end

    RecordFrames = data.frames
    Notify("Loaded: " .. tostring(#RecordFrames) .. " frame")
end

local function ClearRecord()
    StopRecording(false)
    StopPlayback(false)
    RecordFrames = {}
    Notify("Record dihapus dari memory")
end

