-- Fly custom standalone
-- Gerakan memakai CFrame + Humanoid.MoveDirection.
-- Tidak memakai BodyVelocity atau BodyGyro.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local GUI_NAME = "NixxCustomFlyGui"
local FlySpeed = 55

local oldGui = PlayerGui:FindFirstChild(GUI_NAME)
if oldGui then
    oldGui:Destroy()
end

local Flying = false
local FlyConnection = nil
local FlyBtn = nil
local FlyHumanoid = nil
local FlyRoot = nil
local PreviousAutoRotate = true

local KeyState = {
    Forward = false,
    Backward = false,
    Left = false,
    Right = false,
    Up = false,
    Down = false
}

local function SetButtonState(active)
    if not FlyBtn or not FlyBtn.Parent then return end

    FlyBtn.Text = active and "Fly: ON" or "Fly: OFF"
    FlyBtn.BackgroundColor3 = active
        and Color3.fromRGB(0, 150, 190)
        or Color3.fromRGB(35, 35, 45)
end

local function ResetKeys()
    for key in pairs(KeyState) do
        KeyState[key] = false
    end
end

local function GetCharacter()
    local character = Player.Character
    if not character then return nil, nil, nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    return character, humanoid, root
end

local function StopFly()
    Flying = false
    ResetKeys()

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    if FlyRoot and FlyRoot.Parent then
        FlyRoot.AssemblyLinearVelocity = Vector3.zero
    end

    if FlyHumanoid and FlyHumanoid.Parent then
        FlyHumanoid.AutoRotate = PreviousAutoRotate
        FlyHumanoid.PlatformStand = false
    end

    FlyHumanoid = nil
    FlyRoot = nil
    SetButtonState(false)
end

local function GetKeyboardDirection(camera)
    local direction = Vector3.zero

    local flatLook = Vector3.new(
        camera.CFrame.LookVector.X,
        0,
        camera.CFrame.LookVector.Z
    )
    local flatRight = Vector3.new(
        camera.CFrame.RightVector.X,
        0,
        camera.CFrame.RightVector.Z
    )

    if flatLook.Magnitude > 0 then
        flatLook = flatLook.Unit
    end
    if flatRight.Magnitude > 0 then
        flatRight = flatRight.Unit
    end

    if KeyState.Forward then direction += flatLook end
    if KeyState.Backward then direction -= flatLook end
    if KeyState.Right then direction += flatRight end
    if KeyState.Left then direction -= flatRight end

    return direction
end

local function StartFly()
    if Flying then return true end

    local _, humanoid, root = GetCharacter()
    if not humanoid or not root then
        return false
    end

    FlyHumanoid = humanoid
    FlyRoot = root
    PreviousAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid.PlatformStand = false
    Flying = true

    FlyConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not Flying or not FlyRoot or not FlyRoot.Parent then
            StopFly()
            return
        end

        local camera = Workspace.CurrentCamera
        if not camera then return end

        local keyboardDirection = GetKeyboardDirection(camera)
        local moveDirection

        if keyboardDirection.Magnitude > 0 then
            moveDirection = keyboardDirection.Unit
        else
            local humanoidDirection = FlyHumanoid.MoveDirection
            moveDirection = Vector3.new(
                humanoidDirection.X,
                0,
                humanoidDirection.Z
            )
            if moveDirection.Magnitude > 1 then
                moveDirection = moveDirection.Unit
            end
        end

        local verticalDirection = 0
        if KeyState.Up then verticalDirection += 1 end
        if KeyState.Down then verticalDirection -= 1 end

        local finalDirection = moveDirection + Vector3.new(0, verticalDirection, 0)
        if finalDirection.Magnitude > 1 then
            finalDirection = finalDirection.Unit
        end

        local nextPosition = FlyRoot.Position
            + finalDirection * FlySpeed * math.min(deltaTime, 0.05)

        local lookDirection = Vector3.new(
            camera.CFrame.LookVector.X,
            0,
            camera.CFrame.LookVector.Z
        )
        if lookDirection.Magnitude < 0.01 then
            lookDirection = Vector3.new(0, 0, -1)
        else
            lookDirection = lookDirection.Unit
        end

        FlyRoot.CFrame = CFrame.lookAt(
            nextPosition,
            nextPosition + lookDirection
        )
        FlyRoot.AssemblyLinearVelocity = Vector3.zero
    end)

    return true
end

local KeyMap = {
    [Enum.KeyCode.W] = "Forward",
    [Enum.KeyCode.Up] = "Forward",
    [Enum.KeyCode.S] = "Backward",
    [Enum.KeyCode.Down] = "Backward",
    [Enum.KeyCode.A] = "Left",
    [Enum.KeyCode.Left] = "Left",
    [Enum.KeyCode.D] = "Right",
    [Enum.KeyCode.Right] = "Right",
    [Enum.KeyCode.Space] = "Up",
    [Enum.KeyCode.LeftControl] = "Down",
    [Enum.KeyCode.RightControl] = "Down"
}

UserInputService.InputBegan:Connect(function(input)
    local key = KeyMap[input.KeyCode]
    if key then
        KeyState[key] = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    local key = KeyMap[input.KeyCode]
    if key then
        KeyState[key] = false
    end
end)

local FlyGui = Instance.new("ScreenGui")
FlyGui.Name = GUI_NAME
FlyGui.ResetOnSpawn = false
FlyGui.Parent = PlayerGui

local FlyFrame = Instance.new("Frame")
FlyFrame.Size = UDim2.fromOffset(158, 38)
FlyFrame.Position = UDim2.new(0, 20, 0.5, 125)
FlyFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 25)
FlyFrame.BorderSizePixel = 0
FlyFrame.Active = true
FlyFrame.Parent = FlyGui

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 7)
FrameCorner.Parent = FlyFrame

FlyBtn = Instance.new("TextButton")
FlyBtn.Size = UDim2.fromOffset(100, 28)
FlyBtn.Position = UDim2.fromOffset(20, 5)
FlyBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
FlyBtn.BorderSizePixel = 0
FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
FlyBtn.TextSize = 11
FlyBtn.Font = Enum.Font.GothamBold
FlyBtn.Text = "Fly: OFF"
FlyBtn.Parent = FlyFrame

local ButtonCorner = Instance.new("UICorner")
ButtonCorner.CornerRadius = UDim.new(0, 5)
ButtonCorner.Parent = FlyBtn

local DragHandle = Instance.new("TextButton")
DragHandle.Size = UDim2.fromOffset(14, 28)
DragHandle.Position = UDim2.fromOffset(3, 5)
DragHandle.BackgroundTransparency = 1
DragHandle.BorderSizePixel = 0
DragHandle.Text = "≡"
DragHandle.TextColor3 = Color3.fromRGB(150, 150, 165)
DragHandle.TextSize = 16
DragHandle.Font = Enum.Font.GothamBold
DragHandle.Parent = FlyFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(28, 28)
CloseBtn.Position = UDim2.fromOffset(125, 5)
CloseBtn.BackgroundColor3 = Color3.fromRGB(150, 45, 55)
CloseBtn.BorderSizePixel = 0
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.TextSize = 12
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Parent = FlyFrame

local CloseCorner = Instance.new("UICorner")
CloseCorner.CornerRadius = UDim.new(0, 5)
CloseCorner.Parent = CloseBtn

local dragging = false
local dragInput = nil
local dragStart = nil
local startPosition = nil

DragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = FlyFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

DragHandle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        FlyFrame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

FlyBtn.MouseButton1Click:Connect(function()
    if Flying then
        StopFly()
    elseif StartFly() then
        SetButtonState(true)
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    StopFly()
    FlyGui:Destroy()
end)

Player.CharacterAdded:Connect(function()
    StopFly()
end)
