-- Logika Spectate
local playerList = {}
local currentIndex = 1
local isSpectating = true

local function updatePlayerList()
    playerList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(playerList, p)
        end
    end
end

local function updateSpectate()
    if not isSpectating then return end
    updatePlayerList()
    if #playerList == 0 then
        nameLabel.Text = "Username: None"
        ageLabel.Text = "Account Age: 0 days"
        avatarImg.Image = ""
        Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        return
    end
    
    if currentIndex > #playerList then currentIndex = 1 end
    if currentIndex < 1 then currentIndex = #playerList end
    
    local target = playerList[currentIndex]
    if target and target.Character and target.Character:FindFirstChild("Humanoid") then
        nameLabel.Text = "Username: " .. target.Name
        pcall(function()
            ageLabel.Text = "Account Age: " .. target.AccountAge .. " days"
        end)
        
        local content, isReady = Players:GetUserThumbnailAsync(target.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
        if isReady then
            avatarImg.Image = content
        end
        
        Camera.CameraSubject = target.Character.Humanoid
    end
end

prevBtn.MouseButton1Click:Connect(function()
    if isSpectating then
        currentIndex = currentIndex - 1
        updateSpectate()
    end
end)

nextBtn.MouseButton1Click:Connect(function()
    if isSpectating then
        currentIndex = currentIndex + 1
        updateSpectate()
    end
end)

resetBtn.MouseButton1Click:Connect(function()
    isSpectating = false
    playStopBtn.Text = "PLAY"
    playStopBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 100)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        Camera.CameraSubject = LocalPlayer.Character.Humanoid
    end
end)

playStopBtn.MouseButton1Click:Connect(function()
    isSpectating = not isSpectating
    if isSpectating then
        playStopBtn.Text = "STOP"
        playStopBtn.BackgroundColor3 = Color3.fromRGB(220, 160, 40)
        updateSpectate()
    else
        playStopBtn.Text = "PLAY"
        playStopBtn.BackgroundColor3 = Color3.fromRGB(60, 180, 100)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = LocalPlayer.Character.Humanoid
        end
    end
end)

-- Fitur Tombol: Spawn Obunga Raksasa di Map
spawnObungaBtn.MouseButton1Click:Connect(function()
    local npc = Instance.new("Model")
    npc.Name = "GiantObunga"
    
    local hrp = Instance.new("Part")
    hrp.Name = "HumanoidRootPart"
    hrp.Size = Vector3.new(12, 18, 12)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    hrp.Position = myRoot and (myRoot.Position + Vector3.new(0, 10, 15)) or Vector3.new(0, 10, 0)
    hrp.Parent = npc
    
    local humanoid = Instance.new("Humanoid")
    humanoid.MaxHealth = 999999
    humanoid.Health = 999999
    humanoid.Parent = npc
    
    npc.PrimaryPart = hrp
    npc.Parent = Workspace
    
    -- Gerak muter-muter
    task.spawn(function()
        local points = {hrp.Position + Vector3.new(40,0,40), hrp.Position + Vector3.new(-40,0,40)}
        local idx = 1
        while npc and npc.Parent do
            humanoid:MoveTo(points[idx])
            task.wait(3)
            idx = idx == 1 and 2 or 1
        end
    end)
end)

-- Fitur Tombol: Laser Menempel di Badan Sendiri
laserBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and not char:FindFirstChild("BodyLaser") then
        local laser = Instance.new("Part")
        laser.Name = "BodyLaser"
        laser.Size = Vector3.new(2, 2, 20)
        laser.BrickColor = BrickColor.new("Bright red")
        laser.Material = Enum.Material.Neon
        laser.CanCollide = false
        laser.Parent = char
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = hrp
        weld.Part1 = laser
        weld.Parent = laser
        
        laser.CFrame = hrp.CFrame * CFrame.new(0, 3, -10)
    end
end)

